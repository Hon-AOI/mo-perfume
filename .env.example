# Copy this file to .env on the server. Never commit your real Paystack secret.
PAYSTACK_SECRET_KEY=

# Public URL of this app's payment confirmation page.
# Local development example: http://localhost:1969/payment-return.html
PAYSTACK_CALLBACK_URL=

# Delivery fee in NGN. Set to 0 only if delivery is free.
DELIVERY_FEE_NGN=
